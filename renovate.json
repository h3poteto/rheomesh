{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "prConcurrentLimit": 20,
  "prHourlyLimit": 20,
  "toolSettings": {
    "nodeMaxMemory": 1536
  },
  "packageRules": [
    {
      "matchPackageNames": ["next", "@next/**", "eslint-config-next"],
      "enabled": false
    }
  ]
}
